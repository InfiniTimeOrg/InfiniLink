    "You can pin an exercise by long pressing the exercise you want to pin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst eine Übung anheften, indem du lange auf die gewünschte Übung drückst."
          }
        }
      }
    },
    "You can't disable watch notifications while iPhone notifications are on and ANCS is enabled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
